        {
            "name": "Admin - OTP Unblock",
            "item": [
                {
                    "name": "Block Customer (Simulated - Run 'Verify OTP Fail' 3 times)",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "",
                            "host": [
                                ""
                            ]
                        },
                        "description": "Manually run the 'Verify OTP (Fail - Invalid OTP)' request under Customer Auth 3 times first to trigger the block."
                    },
                    "response": []
                },
                {
                    "name": "Attempt Request OTP (Fail - Blocked)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 403 Forbidden\", function () {",
                                    "    pm.response.to.have.status(403);",
                                    "});",
                                    "pm.test(\"Error indicates blocked account\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.error).to.contain(\"account blocked\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"areaCode\": \"{{customerAreaCode}}\",\n    \"mobileNumber\": \"{{customerMobile}}\",\n    \"userType\": \"CUSTOMER\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/otp/request",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "otp",
                                "request"
                            ]
                        },
                        "description": "Confirms that the customer is blocked after 3 failed attempts."
                    },
                    "response": []
                },
                {
                    "name": "Admin Unblock Customer OTP (Success)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 204 No Content\", function () {",
                                    "    pm.response.to.have.status(204);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminAccessToken}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"userType\": \"CUSTOMER\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/admin/users/{{customerUserId}}/otp/unblock",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "admin",
                                "users",
                                "{{customerUserId}}",
                                "otp",
                                "unblock"
                            ]
                        },
                        "description": "Uses the Admin token to unblock the Customer's OTP."
                    },
                    "response": []
                },
                {
                    "name": "Attempt Request OTP (Success - After Unblock)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"areaCode\": \"{{customerAreaCode}}\",\n    \"mobileNumber\": \"{{customerMobile}}\",\n    \"userType\": \"CUSTOMER\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/otp/request",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "otp",
                                "request"
                            ]
                        },
                        "description": "Confirms the customer can request OTP again after being unblocked."
                    },
                    "response": []
                }
            ],
            "description": "Tests the OTP blocking and Admin unblocking flow."
        }
    ]
}