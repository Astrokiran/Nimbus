{
    "info": {
        "_postman_id": "YOUR_UNIQUE_COLLECTION_ID", // Postman will generate this
        "name": "Nimbus Authentication API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Admin Authentication",
            "item": [
                {
                    "name": "Admin Login (Success)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Access and Refresh tokens received\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.accessToken).to.be.a('string');",
                                    "    pm.expect(jsonData.refreshToken).to.be.a('string');",
                                    "    // Set tokens for subsequent requests",
                                    "    pm.environment.set(\"adminAccessToken\", jsonData.accessToken);",
                                    "    pm.environment.set(\"adminRefreshToken\", jsonData.refreshToken);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\",\n    \"deviceType\": \"WEB\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/admin/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "admin",
                                "login"
                            ]
                        },
                        "description": "Login as the pre-configured Admin user. Captures tokens."
                    },
                    "response": []
                },
                {
                    "name": "Admin Login (Fail - Wrong Password)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 401\", function () {",
                                    "    pm.response.to.have.status(401);",
                                    "});",
                                    "pm.test(\"Error message is invalid credentials\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.error).to.eql(\"invalid credentials\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"wrongpassword\",\n    \"deviceType\": \"WEB\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/admin/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "admin",
                                "login"
                            ]
                        }
                    },
                    "response": []
                }
            ],
            "description": "Tests related to Admin user login."
        },
        {
            "name": "Customer Authentication (OTP)",
            "item": [
                {
                    "name": "Request OTP (Success)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"areaCode\": \"{{customerAreaCode}}\",\n    \"mobileNumber\": \"{{customerMobile}}\",\n    \"userType\": \"CUSTOMER\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/otp/request",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "otp",
                                "request"
                            ]
                        },
                        "description": "Requests an OTP for the pre-configured Customer."
                    },
                    "response": []
                },
                {
                    "name": "Verify OTP (Success - Using Test OTP)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Access and Refresh tokens received\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.accessToken).to.be.a('string');",
                                    "    pm.expect(jsonData.refreshToken).to.be.a('string');",
                                    "    // Set tokens for subsequent requests",
                                    "    pm.environment.set(\"customerAccessToken\", jsonData.accessToken);",
                                    "    pm.environment.set(\"customerRefreshToken\", jsonData.refreshToken);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"areaCode\": \"{{customerAreaCode}}\",\n    \"mobileNumber\": \"{{customerMobile}}\",\n    \"otp\": \"{{testOtp}}\",\n    \"userType\": \"CUSTOMER\",\n    \"deviceType\": \"MOBILE\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/otp/verify",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "otp",
                                "verify"
                            ]
                        },
                        "description": "Verifies the OTP using the configured Test OTP value. Captures tokens."
                    },
                    "response": []
                },
                {
                    "name": "Verify OTP (Fail - Invalid OTP)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 401\", function () {",
                                    "    pm.response.to.have.status(401);",
                                    "});",
                                    "pm.test(\"Error message is invalid/expired OTP\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.error).to.eql(\"Invalid or expired OTP\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"areaCode\": \"{{customerAreaCode}}\",\n    \"mobileNumber\": \"{{customerMobile}}\",\n    \"otp\": \"999999\",\n    \"userType\": \"CUSTOMER\",\n    \"deviceType\": \"MOBILE\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/otp/verify",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "otp",
                                "verify"
                            ]
                        },
                        "description": "Attempts to verify with an incorrect OTP."
                    },
                    "response": []
                },
                {
                    "name": "Refresh Token (Success)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"New Access token received\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.accessToken).to.be.a('string');",
                                    "    // Update the access token",
                                    "    pm.environment.set(\"customerAccessToken\", jsonData.accessToken);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"refreshToken\": \"{{customerRefreshToken}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/token/refresh",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "token",
                                "refresh"
                            ]
                        },
                        "description": "Uses the Refresh Token obtained from login/verify to get a new Access Token."
                    },
                    "response": []
                },
                {
                    "name": "Logout (Success)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 204 No Content\", function () {",
                                    "    pm.response.to.have.status(204);",
                                    "});",
                                    "",
                                    "// Clear the tokens locally after successful logout",
                                    "pm.environment.unset(\"customerAccessToken\");",
                                    "pm.environment.unset(\"customerRefreshToken\");"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"refreshToken\": \"{{customerRefreshToken}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/logout",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "logout"
                            ]
                        },
                        "description": "Logs out the current session by revoking the refresh token."
                    },
                    "response": []
                },
                {
                    "name": "Refresh Token (Fail - After Logout)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 401\", function () {",
                                    "    pm.response.to.have.status(401);",
                                    "});",
                                    "pm.test(\"Error message indicates revoked token\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.error).to.eql(\"token has been revoked\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"refreshToken\": \"{{customerRefreshToken}}\" // Should be unset, but try anyway\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/token/refresh",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "token",
                                "refresh"
                            ]
                        },
                        "description": "Attempts to refresh using the token that was just revoked via logout."
                    },
                    "response": []
                }
            ],
            "description": "Tests related to Customer user login via OTP."
        },
